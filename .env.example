# ============================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env dan isi dengan data Anda
# ============================================

# Secret key untuk Flask (generate random string)
SECRET_KEY=your-random-secret-key-here

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Opsi 1: Gunakan DATABASE_URL (recommended untuk cloud)
# Format: mysql://username:password@host:port/database_name
DATABASE_URL=mysql://user:password@xxx.tidbcloud.com:4000/db_proyek

# Opsi 2: Gunakan env vars terpisah (untuk lokal)
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=db_proyek

# ============================================
# PORT (Render otomatis set ini)
# ============================================
# PORT=5001
